# Caddy — piclearn.me
# HTTPS automatique (Let's Encrypt). Sert la page vitrine statique (landing/,
# montée sur /srv/www par docker-compose.prod.yml) et proxifie les chemins
# applicatifs vers le backend FastAPI.

piclearn.me, www.piclearn.me {
	# Chemins servis par le backend (API mobile, santé, fichiers utilisateurs)
	@backend path /api/* /health /images/* /uploads/* /docs /openapi.json
	handle @backend {
		reverse_proxy backend:8000
	}

	# Tout le reste : page vitrine
	handle {
		root * /srv/www
		file_server
	}
}

# Accès direct par IP (ancien point d'entrée HTTP des premiers builds) :
# renvoi permanent vers le domaine. Plus aucun APK en circulation n'utilise
# l'IP brute.
:80 {
	redir https://piclearn.me{uri} permanent
}
